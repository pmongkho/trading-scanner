{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --prefix angular-client",
  "buildCommand": "npm run build --prefix angular-client",
  "outputDirectory": "angular-client/dist/angular-client/browser",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
